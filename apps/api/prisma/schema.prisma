generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  WAITER
  COOK
  CASHIER
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  TRIAL
  EXPIRED
}

enum AdminSessionPolicy {
  deny_second_login
  kick_previous_session
}

enum SessionEndReason {
  logout
  kicked_by_new_login
  revoked_by_super_admin
  expired
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

enum TableStatus {
  FREE
  OCCUPIED
  WAITING_ORDER
  ORDER_COOKING
  ORDER_READY
  CALLING_WAITER
  BILL_REQUESTED
  NEEDS_CLEANING
}

enum OrderStatus {
  NEW
  ACCEPTED
  COOKING
  READY
  DELIVERING
  SERVED
  BILL_REQUESTED
  PAID
  CLOSED
  CANCEL_REQUESTED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  COOKING
  READY
  SERVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
  TRANSFER
  MIXED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum WaiterCallType {
  CALL
  BILL
}

enum WaiterCallStatus {
  PENDING
  ACCEPTED
  CLOSED
}

enum FeedbackType {
  REVIEW
  COMPLAINT
  SUGGESTION
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Core ────────────────────────────────────────────────────────────────────

model Restaurant {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  logoUrl            String?            @map("logo_url")
  phone              String?
  address            String?
  city               String?
  currency           String             @default("KGS")
  language           String             @default("ru")
  workingHours       Json?              @map("working_hours")
  isOpen             Boolean            @default(true) @map("is_open")
  status             RestaurantStatus   @default(TRIAL)
  tariffId           String?            @map("tariff_id")
  subscriptionEndsAt DateTime?          @map("subscription_ends_at")
  adminLimit         Int                @default(1) @map("admin_limit")
  adminSessionPolicy AdminSessionPolicy @default(deny_second_login) @map("admin_session_policy")
  allowOrders        Boolean            @default(true) @map("allow_orders")
  allowWaiterCalls   Boolean            @default(true) @map("allow_waiter_calls")
  allowBillRequests  Boolean            @default(true) @map("allow_bill_requests")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  users          User[]
  halls          Hall[]
  tables         Table[]
  menuCategories MenuCategory[]
  dishes         Dish[]
  orders         Order[]
  feedback       Feedback[]
  subscriptions  Subscription[]
  supportTickets SupportTicket[]
  auditLogs      AuditLog[]
  sessions       UserSession[]
  tariff         Plan?           @relation("RestaurantTariff", fields: [tariffId], references: [id])

  @@map("restaurants")
}

model Plan {
  id         String   @id @default(cuid())
  name       String
  price      Decimal  @db.Decimal(10, 2)
  periodDays Int      @map("period_days")
  limits     Json
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]
  restaurants   Restaurant[]   @relation("RestaurantTariff")

  @@map("plans")
}

model Subscription {
  id           String             @id @default(cuid())
  restaurantId String             @map("restaurant_id")
  planId       String             @map("plan_id")
  startsAt     DateTime           @map("starts_at")
  endsAt       DateTime           @map("ends_at")
  status       SubscriptionStatus @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  plan       Plan       @relation(fields: [planId], references: [id])

  @@index([restaurantId, status])
  @@map("subscriptions")
}

model User {
  id           String   @id @default(cuid())
  restaurantId String?  @map("restaurant_id")
  role         Role
  name         String
  login        String   @unique
  email        String?  @unique
  phone        String?
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant         Restaurant?          @relation(fields: [restaurantId], references: [id])
  refreshTokens      RefreshToken[]
  sessions           UserSession[]
  shifts             Shift[]
  assignedTables     Table[]              @relation("WaiterTables")
  orders             Order[]              @relation("WaiterOrders")
  notifications      Notification[]
  auditLogs          AuditLog[]
  supportTickets     SupportTicket[]
  supportMessages    SupportMessage[]
  orderStatusHistory OrderStatusHistory[]

  @@index([restaurantId, role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model UserSession {
  id               String            @id @default(cuid())
  userId           String            @map("user_id")
  restaurantId     String?           @map("restaurant_id")
  role             Role
  sessionId        String            @unique @default(uuid()) @map("session_id")
  refreshTokenHash String            @map("refresh_token_hash")
  isActive         Boolean           @default(true) @map("is_active")
  ipAddress        String?           @map("ip_address")
  userAgent        String?           @map("user_agent")
  createdAt        DateTime          @default(now()) @map("created_at")
  lastSeenAt       DateTime          @default(now()) @map("last_seen_at")
  expiresAt        DateTime          @map("expires_at")
  logoutAt         DateTime?         @map("logout_at")
  revokedAt        DateTime?         @map("revoked_at")
  endReason        SessionEndReason? @map("end_reason")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([restaurantId, role, isActive])
  @@index([restaurantId, createdAt])
  @@map("user_sessions")
}

// ─── Shifts ──────────────────────────────────────────────────────────────────

model Shift {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  ordersCount Int       @default(0) @map("orders_count")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("shifts")
}

// ─── Tables & QR ─────────────────────────────────────────────────────────────

model Hall {
  id           String @id @default(cuid())
  restaurantId String @map("restaurant_id")
  name         String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  tables     Table[]

  @@map("halls")
}

model Table {
  id           String      @id @default(cuid())
  restaurantId String      @map("restaurant_id")
  hallId       String?     @map("hall_id")
  number       Int
  status       TableStatus @default(FREE)
  waiterId     String?     @map("waiter_id")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  restaurant  Restaurant   @relation(fields: [restaurantId], references: [id])
  hall        Hall?        @relation(fields: [hallId], references: [id])
  waiter      User?        @relation("WaiterTables", fields: [waiterId], references: [id])
  qrCodes     QrCode[]
  orders      Order[]
  waiterCalls WaiterCall[]

  @@unique([restaurantId, number])
  @@map("tables")
}

model QrCode {
  id        String   @id @default(cuid())
  tableId   String   @map("table_id")
  token     String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  table Table @relation(fields: [tableId], references: [id])

  @@index([tableId, isActive])
  @@map("qr_codes")
}

// ─── Menu ────────────────────────────────────────────────────────────────────

model MenuCategory {
  id           String  @id @default(cuid())
  restaurantId String  @map("restaurant_id")
  name         String
  nameKy       String? @map("name_ky")
  nameEn       String? @map("name_en")
  sortOrder    Int     @default(0) @map("sort_order")
  isVisible    Boolean @default(true) @map("is_visible")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  dishes     Dish[]

  @@map("menu_categories")
}

model Dish {
  id             String    @id @default(cuid())
  restaurantId   String    @map("restaurant_id")
  categoryId     String    @map("category_id")
  name           String
  nameKy         String?   @map("name_ky")
  nameEn         String?   @map("name_en")
  description    String?
  descriptionKy  String?   @map("description_ky")
  descriptionEn  String?   @map("description_en")
  photoUrl       String?   @map("photo_url")
  price          Decimal   @db.Decimal(10, 2)
  weight         Int?
  cookTimeMin    Int?      @map("cook_time_min")
  isActive       Boolean   @default(true) @map("is_active")
  isVisible      Boolean   @default(true) @map("is_visible")
  inStoplist     Boolean   @default(false) @map("in_stoplist")
  stoplistReason String?   @map("stoplist_reason")
  stoplistUntil  DateTime? @map("stoplist_until")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id])
  category   MenuCategory  @relation(fields: [categoryId], references: [id])
  variants   DishVariant[]
  addons     DishAddon[]
  orderItems OrderItem[]

  @@index([restaurantId, categoryId])
  @@map("dishes")
}

model DishVariant {
  id         String  @id @default(cuid())
  dishId     String  @map("dish_id")
  name       String
  priceDelta Decimal @default(0) @map("price_delta") @db.Decimal(10, 2)
  isActive   Boolean @default(true) @map("is_active")

  dish       Dish        @relation(fields: [dishId], references: [id])
  orderItems OrderItem[]

  @@map("dish_variants")
}

model DishAddon {
  id       String  @id @default(cuid())
  dishId   String  @map("dish_id")
  name     String
  price    Decimal @db.Decimal(10, 2)
  isActive Boolean @default(true) @map("is_active")

  dish            Dish             @relation(fields: [dishId], references: [id])
  orderItemAddons OrderItemAddon[]

  @@map("dish_addons")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id            String      @id @default(cuid())
  publicToken   String      @unique @default(uuid()) @map("public_token")
  restaurantId  String      @map("restaurant_id")
  tableId       String      @map("table_id")
  waiterId      String?     @map("waiter_id")
  status        OrderStatus @default(NEW)
  clientComment String?     @map("client_comment")
  total         Decimal     @default(0) @db.Decimal(10, 2)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  closedAt      DateTime?   @map("closed_at")

  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id])
  table         Table                @relation(fields: [tableId], references: [id])
  waiter        User?                @relation("WaiterOrders", fields: [waiterId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  feedback      Feedback[]
  waiterCalls   WaiterCall[]

  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
  @@index([restaurantId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String          @map("order_id")
  dishId        String          @map("dish_id")
  variantId     String?         @map("variant_id")
  qty           Int             @default(1)
  priceAtMoment Decimal         @map("price_at_moment") @db.Decimal(10, 2)
  comment       String?
  status        OrderItemStatus @default(PENDING)

  order   Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish    Dish             @relation(fields: [dishId], references: [id])
  variant DishVariant?     @relation(fields: [variantId], references: [id])
  addons  OrderItemAddon[]

  @@map("order_items")
}

model OrderItemAddon {
  id            String  @id @default(cuid())
  orderItemId   String  @map("order_item_id")
  addonId       String  @map("addon_id")
  priceAtMoment Decimal @map("price_at_moment") @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addon     DishAddon @relation(fields: [addonId], references: [id])

  @@map("order_item_addons")
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String       @map("order_id")
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  changedById String?      @map("changed_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id])

  @@map("order_status_history")
}

// ─── Payments ────────────────────────────────────────────────────────────────

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @map("order_id")
  method          PaymentMethod
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  cancelledReason String?       @map("cancelled_reason")
  createdById     String?       @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}

// ─── Waiter Calls ────────────────────────────────────────────────────────────

model WaiterCall {
  id        String           @id @default(cuid())
  tableId   String           @map("table_id")
  orderId   String?          @map("order_id")
  type      WaiterCallType
  status    WaiterCallStatus @default(PENDING)
  createdAt DateTime         @default(now()) @map("created_at")
  closedAt  DateTime?        @map("closed_at")

  table Table  @relation(fields: [tableId], references: [id])
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tableId, status])
  @@map("waiter_calls")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  payload   Json
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── Feedback ────────────────────────────────────────────────────────────────

model Feedback {
  id           String       @id @default(cuid())
  restaurantId String       @map("restaurant_id")
  orderId      String?      @map("order_id")
  rating       Int
  comment      String?
  type         FeedbackType @default(REVIEW)
  reply        String?
  repliedAt    DateTime?    @map("replied_at")
  isReviewed   Boolean      @default(false) @map("is_reviewed")
  reviewedAt   DateTime?    @map("reviewed_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  order      Order?     @relation(fields: [orderId], references: [id])

  @@map("feedback")
}

// ─── Support ─────────────────────────────────────────────────────────────────

model SupportTicket {
  id           String                @id @default(cuid())
  restaurantId String                @map("restaurant_id")
  authorId     String                @map("author_id")
  type         String
  priority     SupportTicketPriority @default(MEDIUM)
  status       SupportTicketStatus   @default(OPEN)
  subject      String
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id])
  author     User             @relation(fields: [authorId], references: [id])
  messages   SupportMessage[]

  @@map("support_tickets")
}

model SupportMessage {
  id            String   @id @default(cuid())
  ticketId      String   @map("ticket_id")
  authorId      String   @map("author_id")
  text          String
  screenshotUrl String?  @map("screenshot_url")
  createdAt     DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@map("support_messages")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  restaurantId String?  @map("restaurant_id")
  action       String
  entity       String
  entityId     String?  @map("entity_id")
  diff         Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User?       @relation(fields: [userId], references: [id])
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId, createdAt])
  @@map("audit_logs")
}
